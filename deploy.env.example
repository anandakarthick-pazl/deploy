# Copy to /etc/packwork-deploy.env and fill in real values.
# Shared by all repos configured in repos.json.

# Shared webhook secret (paste the same value into every GitHub webhook's "Secret" field)
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional: override path to repos.json (defaults to ./repos.json next to this script)
# REPOS_CONFIG=/srv/code/Source_Code/packworx/deploy/repos.json

# SMTP (Gmail example — use a Gmail App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=Packwork Deploy
# Fallback recipient(s) used only if a repo in repos.json has no "recipients" set.
MAIL_TO=ananda.s@pazl.info

# Max seconds a single post-deploy command may run (npm install + build can be slow)
CMD_TIMEOUT=600
