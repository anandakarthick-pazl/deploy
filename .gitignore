# Python virtualenv — 79 MB, rebuild with: python3 -m venv venv && venv/bin/pip install -r requirements.txt
venv/
__pycache__/
*.py[cod]

# Real secrets live in /etc/packwork-deploy.env — never in the repo.
# deploy.env.example is the tracked template.
.env
*.env
!deploy.env.example

# Local editor backups of source files
*.bak
*.bak-*

# Runtime state
static/uploads/*
!static/uploads/.gitkeep
*.log
instance/
