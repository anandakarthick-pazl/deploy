[Unit]
Description=Packwork Multi-Repo Auto-Deploy Webhook (gunicorn)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/code/Source_Code/packworx/deploy
EnvironmentFile=/etc/packwork-deploy.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/srv/code/Source_Code/packworx/deploy/venv/bin/gunicorn \
          -w 2 -b 127.0.0.1:9000 \
          --timeout 30 \
          --access-logfile /var/log/packwork-deploy.access.log \
          --error-logfile  /var/log/packwork-deploy.error.log \
          deploy_webhook:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
